      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  $__timeGroupAlias(time, $__interval),\n  avg(value) AS \"mean\",\n  max(value) AS \"max\",\n  min(value) AS \"min\"\nFROM records\nWHERE measurement IN (${metrics:sqlstring})\n  AND $__timeFilter(time)\n  AND (device ~ '^${source:regex}$')\nGROUP BY 1\nORDER BY 1",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "postgres",
            "uid": "postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH buckets AS (\n  SELECT\n    $__timeGroup(time, $__interval) AS bucket,\n    avg(value) AS y\n  FROM records\n  WHERE measurement IN (${metrics:sqlstring})\n    AND $__timeFilter(time)\n    AND (device ~ '^${source:regex}$')\n  GROUP BY 1\n)\nSELECT\n  bucket AS time,\n  (SELECT regr_intercept(y, bucket) FROM buckets)\n    + (SELECT regr_slope(y, bucket) FROM buckets) * bucket AS \"trend\"\nFROM buckets\nORDER BY 1",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "postgres",
            "uid": "postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE unit\n    WHEN 'count' THEN 'short'\n    WHEN 'count/min' THEN 'suffix: /min'\n    WHEN '%' THEN 'percentunit'\n    WHEN 'min' THEN 'm'\n    WHEN 'hr' THEN 'h'\n    WHEN 's' THEN 's'\n    WHEN 'kg' THEN 'masskg'\n    WHEN 'g' THEN 'massg'\n    WHEN 'mg' THEN 'massmg'\n    WHEN 'km' THEN 'lengthkm'\n    WHEN 'km/hr' THEN 'velocitykmh'\n    WHEN 'mL' THEN 'mlitre'\n    WHEN 'degC' THEN 'celsius'\n    WHEN 'dBASPL' THEN 'dB'\n    ELSE 'suffix: ' || unit\n  END AS unit\nFROM records\nWHERE measurement IN (${metrics:sqlstring})\nLIMIT 1",
          "refId": "UNIT"
        }
      ],
      "title": "${metrics}",
      "type": "timeseries",
      "transformations": [
        {
          "id": "configFromData",
          "options": {
            "configRefId": "UNIT",
            "mappings": [
              {
                "fieldName": "unit",
                "handlerKey": "unit"
              }
            ]
          }
        }
      ]
    }
