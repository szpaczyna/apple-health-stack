# Settings for running the ingester against your own PostgreSQL server.
# Copy to ingester/.env and load it with one of:
#   docker run --rm --env-file ingester/.env -v ./export.zip:/app/export.zip:ro <image>
#   set -a; . ingester/.env; set +a; apple-health-ingester
# Leave a line commented out to keep its default; an empty value counts as unset.
# ingester/config.example.yaml holds the same settings as a YAML file.

PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
# Without PG_PASS the ingester reads the password from a pgpass file:
# PG_PASSFILE, then PGPASSFILE, then ~/.pgpass.
# PG_PASS=change-me
# PG_PASSFILE=~/.pgpass
PG_DB=health

# ZIP_PATH=./export.zip
# BATCH_SIZE=15000
# GPX_WORKERS=4
# DB_WAIT_TIMEOUT=120
# UNPACK_DIR=/tmp/apple-health-export
# APPLE_HEALTH_CONFIG=~/.config/apple-health-ingester/config.yaml
