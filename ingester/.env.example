# Settings for running the ingester against your own PostgreSQL server.
# Copy to ingester/.env and load it with one of:
#   docker run --rm --env-file ingester/.env -v ./export.zip:/app/export.zip:ro <image>
#   set -a; . ingester/.env; set +a; python ingester/app.py
# Leave a line commented out to keep its default; an empty value is not a default.

PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
# Without PG_PASS the ingester reads the password from ~/.pgpass.
# PG_PASS=change-me
PG_DB=health

# ZIP_PATH=./export.zip
# BATCH_SIZE=15000
# GPX_WORKERS=4
# DB_MAX_RETRIES=5
# DB_RETRY_COOLDOWN=10
